///|
/// Actual container stream index, not a subtitle ordinal. Language is metadata,
/// supplied by the file's author, never detected from the text.
pub(all) struct Track {
  index : Int
  kind : String
  codec : String
  language : String
  title : String
  is_default : Bool
  forced : Bool
} derive(Eq, ToJson)

///|
pub(all) struct Media {
  suffix : String
  duration_ms : Int
  tracks : Array[Track]
  chapters : Array[Json]
} derive(ToJson)

///|
fn tag(stream : Json, name : String, fallback : String) -> String {
  match stream {
    { "tags": Object(tags), .. } =>
      match tags.get(name) {
        Some(String(value)) => value
        _ => fallback
      }
    _ => fallback
  }
}

///|
/// Inspect a bounded local MP4/Matroska profile. Unknown streams are rejected,
/// except MP4 chapter navigation data regenerated by FFmpeg from chapter metadata.
pub fn inspect_media(probe : Json) -> Media raise {
  guard probe
    is {
      "streams": Array(streams),
      "chapters": Array(chapters),
      "format": {
        "format_name": String(format),
        "duration": String(duration),
        "start_time": String(start),
        ..
      },
      ..
    } else {
    fail("incomplete media probe")
  }
  let suffix = match format {
    "mov,mp4,m4a,3gp,3g2,mj2" => ".mp4"
    "matroska,webm" => ".mkv"
    _ => fail("select an actual MP4 or Matroska video")
  }
  let duration = @string.parse_double(duration) * 1000.0
  let start = @string.parse_double(start)
  guard duration >= 1.0 &&
    duration <= 7200000.0 &&
    start >= -0.001 &&
    start <= 0.001 else {
    fail("media must start at zero and last at most two hours")
  }
  let tracks : Array[Track] = []
  let mut videos = 0
  for stream in streams {
    guard stream
      is {
        "index": Number(index),
        "codec_type": String(kind),
        "codec_name": String(codec),
        ..
      } &&
      index >= 0.0 &&
      index <= 1000.0 &&
      index == index.to_int().to_double() else {
      fail("incomplete stream metadata")
    }
    if kind == "data" &&
      !chapters.is_empty() &&
      codec == "bin_data" &&
      stream is { "codec_tag_string": String("text"), .. } {
      continue
    }
    guard kind == "video" || kind == "audio" || kind == "subtitle" else {
      fail("unsupported stream type: " + kind)
    }
    if kind == "video" {
      videos += 1
      guard stream is { "disposition": { "attached_pic": Number(0), .. }, .. } else {
        fail("attached pictures are outside this profile")
      }
    }
    guard !tracks.any(t => t.index == index.to_int()) else {
      fail("duplicate stream index")
    }
    tracks.push({
      index: index.to_int(),
      kind,
      codec,
      language: tag(stream, "language", "und"),
      title: tag(stream, "title", tag(stream, "handler_name", "")),
      is_default: stream is { "disposition": { "default": Number(1), .. }, .. },
      forced: stream is { "disposition": { "forced": Number(1), .. }, .. },
    })
  }
  guard videos == 1 && tracks.length() <= 17 && chapters.length() <= 1000 else {
    fail("expected one video, at most 17 tracks and 1000 chapters")
  }
  { suffix, duration_ms: (duration + 0.5).to_int(), tracks, chapters, }
}

///|
/// Select only an explicitly named text-subtitle stream. No OCR or speech
/// recognition is attempted for image subtitles or audio tracks.
pub fn select_track(media : Media, index : Int) -> Track raise {
  guard media.tracks.iter().find_first(t => t.index == index) is Some(track) else {
    fail("stream index was not found; use inspect first")
  }
  guard track.kind == "subtitle" &&
    (
      track.codec == "mov_text" ||
      track.codec == "subrip" ||
      track.codec == "webvtt"
    ) else {
    fail("selected stream must be mov_text, subrip or webvtt text subtitles")
  }
  track
}

///|
pub fn validate_attachment(
  media : Media,
  draft : @captions.CaptionDraft,
  language : String,
  title : String,
) -> Unit raise {
  draft.validate()
  guard media.tracks.length() < 17 else { fail("no room for another track") }
  guard (media.duration_ms - draft.duration_ms).abs() <= 50 else {
    fail("caption draft and media duration differ by more than 50 ms")
  }
  guard language.length() == 3 && language.iter().all(c => c >= 'a' && c <= 'z') else {
    fail("language must be a three-letter lowercase code; use und for unknown")
  }
  guard !title.is_blank() &&
    title.length() <= 120 &&
    title.iter().all(c => c >= ' ') else {
    fail("track title must contain 1–120 characters without controls")
  }
  let mut end_ms = 0
  for cue in draft.cues {
    guard cue.start_ms >= end_ms else {
      fail(
        "attachment requires nonoverlapping cues; revise overlapping speakers first",
      )
    }
    end_ms = cue.end_ms
  }
  ignore(draft.srt())
}

///|
/// The MP4 muxer enables the first subtitle track when no earlier one exists.
/// Make that container behavior explicit in preview and output verification.
pub fn appended_track_is_default(media : Media) -> Bool {
  media.suffix == ".mp4" && !media.tracks.any(t => t.kind == "subtitle")
}

///|
/// Append one subtitle, copy every existing A/V/subtitle stream, retain chapters.
/// Additional tracks are not default; the first MP4 subtitle is. Never forced.
pub fn attach_arguments(
  media : Media,
  source : String,
  srt : String,
  language : String,
  title : String,
  output : String,
) -> Array[String] {
  let args = [
    "-hide_banner", "-v", "error", "-nostdin", "-n", "-protocol_whitelist", "file,pipe",
    "-i", source, "-protocol_whitelist", "file,pipe", "-f", "srt", "-i", srt,
  ]
  for track in media.tracks {
    args.append(["-map", "0:" + track.index.to_string()])
  }
  let index = media.tracks.length().to_string()
  let codec = if media.suffix == ".mp4" { "mov_text" } else { "srt" }
  args.append([
    "-map",
    "1:0",
    "-map_metadata",
    "0",
    "-map_chapters",
    "0",
    "-c",
    "copy",
    "-c:" + index,
    codec,
    "-metadata:s:" + index,
    "language=" + language,
    "-metadata:s:" + index,
    "title=" + title,
    "-metadata:s:" + index,
    "handler_name=" + title,
    "-disposition:" + index,
    if appended_track_is_default(media) {
      "default"
    } else {
      "0"
    },
    output,
  ])
  args
}

///|
pub fn extract_arguments(source : String, index : Int) -> Array[String] {
  [
    "-hide_banner",
    "-v",
    "error",
    "-nostdin",
    "-protocol_whitelist",
    "file,pipe",
    "-i",
    source,
    "-map",
    "0:" + index.to_string(),
    "-c:s",
    "srt",
    "-f",
    "srt",
    "pipe:1",
  ]
}

///|
fn chapter_time(chapter : Json, key : String) -> Double raise {
  guard chapter is Object(fields) && fields.get(key) is Some(String(value)) else {
    fail("incomplete chapter timing")
  }
  @string.parse_double(value)
}

///|
/// Check retained stream metadata, chapter titles/times and the appended track.
/// Cue text/timing is verified separately by decoding this actual output track.
pub fn verify_attachment(
  before : Media,
  after : Media,
  language : String,
  title : String,
) -> Track raise {
  guard before.suffix == after.suffix &&
    (before.duration_ms - after.duration_ms).abs() <= 50 &&
    after.tracks.length() == before.tracks.length() + 1 else {
    fail("output container, duration or stream count changed unexpectedly")
  }
  for i, old in before.tracks {
    let got = after.tracks[i]
    guard old.kind == got.kind &&
      old.codec == got.codec &&
      old.language == got.language &&
      old.is_default == got.is_default &&
      old.forced == got.forced else {
      fail("an existing stream changed codec, language or disposition")
    }
  }
  guard before.chapters.length() == after.chapters.length() else {
    fail("chapter count changed")
  }
  for i, old in before.chapters {
    let got = after.chapters[i]
    guard tag(old, "title", "") == tag(got, "title", "") &&
      (chapter_time(old, "start_time") - chapter_time(got, "start_time")).abs() <=
      0.001 &&
      (chapter_time(old, "end_time") - chapter_time(got, "end_time")).abs() <=
      0.001 else {
      fail("chapter timing or title changed")
    }
  }
  let added = after.tracks[before.tracks.length()]
  let codec = if before.suffix == ".mp4" { "mov_text" } else { "subrip" }
  guard added.kind == "subtitle" &&
    added.codec == codec &&
    added.language == language &&
    added.title == title &&
    added.is_default == appended_track_is_default(before) &&
    !added.forced else {
    fail("caption track metadata changed")
  }
  added
}
