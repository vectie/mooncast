///|
/// One explicit source stream, transcoded to a portable listening copy. No
/// normalization, mixing, trimming or automatic track selection is performed.
pub fn compile_audio_edition(
  source : String,
  audio_index : Int,
  channels : Int,
  language : String,
  metadata : String,
  output : String,
) -> @process.CommandSpec {
  {
    executable: "ffmpeg",
    arguments: [
      "-hide_banner",
      "-v",
      "error",
      "-nostdin",
      "-n",
      "-threads",
      "1",
      "-protocol_whitelist",
      "file,pipe",
      "-i",
      source,
      "-protocol_whitelist",
      "file,pipe",
      "-f",
      "ffmetadata",
      "-i",
      metadata,
      "-map",
      "0:" + audio_index.to_string(),
      "-map_metadata",
      "1",
      "-map_chapters",
      "1",
      "-c:a",
      "aac",
      "-b:a",
      "160k",
      "-ar",
      "48000",
      "-ac",
      channels.to_string(),
      "-metadata:s:a:0",
      "language=" + language,
      "-threads",
      "1",
      "-movflags",
      "+faststart",
      "-f",
      "ipod",
      output,
    ],
    working_directory: None,
    timeout_ms: 600000,
    max_output_bytes: 2097152,
  }
}
