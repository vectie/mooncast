  type AgentGraphProposal,
  type ArtifactAnnotation,
  type ArtifactKind,
  type CachedNodeOutput,
  type CapsuleParameter,
  type CapsulePort,
  type CreativeCapsule,
  type ExecutionContext,
  type ExecutionPlan,
  type GraphDiff,
