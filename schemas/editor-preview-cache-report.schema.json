{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncast.local/schemas/editor-preview-cache-report.schema.json",
  "title": "Responsive editor preview cache report",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "profile", "segment_count", "cache_hit_ranges", "cache_miss_ranges", "rebuilt_ranges", "proxy_readiness", "evicted_segment_keys", "invalidated_segment_keys", "segment_keys", "quota", "report_digest"],
  "properties": {
    "contract": {"const": "mooncast.editor-preview-cache-report.v1"},
    "profile": {"const": "mooncast-editor-compositor/bounded-low-resolution-v1"},
    "segment_count": {"type": "integer", "minimum": 1},
    "cache_hit_ranges": {"$ref": "#/$defs/ranges"},
    "cache_miss_ranges": {"$ref": "#/$defs/ranges"},
    "rebuilt_ranges": {"$ref": "#/$defs/ranges"},
    "proxy_readiness": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_digest", "proxy_digest", "state", "cache_hit", "profile"],
        "properties": {
          "source_digest": {"$ref": "#/$defs/digest"}, "proxy_digest": {"$ref": "#/$defs/digest"},
          "state": {"const": "ready"}, "cache_hit": {"type": "boolean"},
          "profile": {"const": "mooncast-review-source-proxy@1.0.0"}
        }
      }
    },
    "evicted_segment_keys": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "invalidated_segment_keys": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "segment_keys": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}},
    "report_digest": {"$ref": "#/$defs/digest"},
    "quota": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_bytes", "maximum_segments", "current_bytes", "current_segments"],
      "properties": {
        "maximum_bytes": {"type": "integer", "minimum": 1}, "maximum_segments": {"type": "integer", "minimum": 1},
        "current_bytes": {"type": "integer", "minimum": 0}, "current_segments": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "range": {"type": "object", "additionalProperties": false, "required": ["start_tick", "duration_ticks"], "properties": {"start_tick": {"type": "integer", "minimum": 0}, "duration_ticks": {"type": "integer", "minimum": 1}}},
    "ranges": {"type": "array", "items": {"$ref": "#/$defs/range"}}
  }
}
