{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mooncast://creative-decision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "decision_id", "artifact_type", "artifact_version", "artifact_digest", "decision", "actor", "actor_role", "decided_at", "client_revision_round"],
  "properties": {
    "contract": {"const": "mooncast.creative-decision.v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "artifact_type": {"enum": ["brief", "rights-ledger", "ip-bible", "script", "claims-ledger", "storyboard", "animatic"]},
    "artifact_version": {"type": "integer", "minimum": 1},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "decision": {"enum": ["approve", "reject", "request-revision", "invalidated"]},
    "actor": {"type": "string", "minLength": 1},
    "actor_role": {"type": "string", "minLength": 1},
    "note": {"type": "string"},
    "decided_at": {"type": "string", "format": "date-time"},
    "client_revision_round": {"type": ["integer", "null"], "minimum": 1, "maximum": 2}
  }
}
