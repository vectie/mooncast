{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncast.local/contracts/final-deliverable-evidence.v1.schema.json",
  "title": "Mooncast final deliverable evidence",
  "type": "object",
  "properties": {
    "contract": {"const": "mooncast.final-deliverable-evidence.v1"},
    "record": {"$ref": "#/$defs/recordRef"},
    "project_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "export_job_id": {"type": "string", "minLength": 1},
    "editor_output_digest": {"type": "string", "minLength": 1},
    "render_plan_digest": {"type": "string", "minLength": 1},
    "lineage_evidence_digest": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "integer", "minimum": 180, "maximum": 480},
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recordRef"}},
    "publication_authority": {"const": false},
    "external_effect_authorized": {"const": false},
    "prepared_at": {"type": "string", "minLength": 1}
  },
  "required": ["contract", "record", "project_id", "episode_id", "export_job_id", "editor_output_digest", "render_plan_digest", "lineage_evidence_digest", "duration_seconds", "source_refs", "publication_authority", "external_effect_authorized", "prepared_at"],
  "additionalProperties": false,
  "$defs": {
    "recordRef": {
      "type": "object",
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "record_version": {"type": "string", "minLength": 1},
        "record_digest": {"type": "string", "minLength": 1},
        "provenance_ref": {"type": "string", "minLength": 1}
      },
      "required": ["record_id", "record_version", "record_digest", "provenance_ref"],
      "additionalProperties": false
    }
  }
}
