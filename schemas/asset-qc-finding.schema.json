{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncast.local/schemas/asset-qc-finding.schema.json",
  "title": "Mooncast reusable asset QC finding",
  "type": "object",
  "required": ["contract", "finding_id", "variant_id", "dimension", "status", "evidence_digest", "reviewer", "reviewer_role", "reviewed_at", "human_confirmed", "immutable"],
  "properties": {
    "contract": {"const": "mooncast.asset-qc-finding.v1"},
    "finding_id": {"type": "string", "minLength": 1},
    "variant_id": {"type": "string", "minLength": 1},
    "dimension": {"enum": ["technical", "identity", "continuity", "rights", "safety"]},
    "status": {"enum": ["pass", "fail"]},
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reviewer": {"type": "string", "minLength": 1},
    "reviewer_role": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1},
    "human_confirmed": {"const": true},
    "immutable": {"const": true}
  },
  "additionalProperties": false
}
