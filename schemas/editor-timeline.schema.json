{
  "$id": "https://mooncast.local/contracts/editor-timeline.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "mooncast.editor-timeline.v1"
    },
    "revision": {
      "minimum": 0,
      "type": "integer"
    },
    "timebase": {
      "additionalProperties": false,
      "properties": {
        "ticks_per_second": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "ticks_per_second"
      ],
      "type": "object"
    },
    "timeline_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "output": {
      "additionalProperties": false,
      "required": ["preset", "orientation", "width", "height", "fps", "background"],
      "properties": {
        "preset": {"enum": ["horizontal-1080p", "vertical-1080p"]},
        "orientation": {"enum": ["horizontal", "vertical"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": {"type": "integer", "minimum": 1},
            "denominator": {"type": "integer", "minimum": 1}
          },
          "type": "object"
        },
        "background": {"type": "string", "minLength": 1}
      },
      "type": "object"
    },
    "tracks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "clips": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "artifact_id": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "clip_id": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "duration_ticks": {
                  "minimum": 1,
                  "type": "integer"
                },
                "identity": {
                  "additionalProperties": false,
                  "properties": {
                    "asset_id": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    },
                    "episode_id": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    },
                    "project_id": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    },
                    "scene_id": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    },
                    "shot_id": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "project_id",
                    "episode_id",
                    "scene_id",
                    "shot_id",
                    "asset_id"
                  ],
                  "type": "object"
                },
                "intent": {
                  "additionalProperties": false,
                  "properties": {
                    "intent_ref": {
                      "pattern": "^moonwiki:intent:[A-Za-z0-9._:-]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "intent_ref"
                  ],
                  "type": "object"
                },
                "media_ref_id": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string"
                },
                "source_in_tick": {
                  "minimum": 0,
                  "type": "integer"
                },
                "source_out_tick": {
                  "minimum": 1,
                  "type": "integer"
                },
                "start_tick": {
                  "minimum": 0,
                  "type": "integer"
                },
                "settings": {
                  "type": "object"
                }
              },
              "required": [
                "clip_id",
                "media_ref_id",
                "identity",
                "intent",
                "start_tick",
                "duration_ticks",
                "source_in_tick",
                "source_out_tick"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "kind": {
            "enum": [
              "video",
              "audio",
              "overlay"
            ]
          },
          "mix": {
            "additionalProperties": false,
            "required": ["volume_db", "pan", "muted"],
            "properties": {
              "volume_db": {"type": "number", "minimum": -60, "maximum": 12},
              "pan": {"type": "number", "minimum": -1, "maximum": 1},
              "muted": {"type": "boolean"}
            },
            "type": "object"
          },
          "order": {
            "minimum": 0,
            "type": "integer"
          },
          "track_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "track_id",
          "kind",
          "order",
          "clips"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "transitions": {
      "type": "array",
      "items": {"$ref": "editor-transition.schema.json"}
    }
  },
  "required": [
    "contract",
    "timeline_id",
    "revision",
    "timebase",
    "output",
    "tracks",
    "transitions"
  ],
  "title": "Editor Timeline v1",
  "type": "object"
}
