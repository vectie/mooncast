{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncast.local/schemas/postprocess-task.schema.json",
  "type": "object",
  "required": ["contract", "reference", "project_id", "project_revision", "operation", "source_assets", "prompt_digest", "rights_refs", "shot_ids", "terminology_refs", "provider_adapter_id", "provider", "model", "permitted_data_class", "cost_ceiling_cny", "retry_limit", "created_at", "provider_execution_authority", "publication_authority"],
  "properties": {
    "contract": {"const": "mooncast.postprocess-task.v1"},
    "operation": {"enum": ["lip-sync", "translation", "upscale"]},
    "source_assets": {"type": "array", "minItems": 1},
    "rights_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "cost_ceiling_cny": {"type": "number", "minimum": 0},
    "retry_limit": {"type": "integer", "minimum": 1, "maximum": 5},
    "provider_execution_authority": {"const": false},
    "publication_authority": {"const": false}
  },
  "additionalProperties": true
}
