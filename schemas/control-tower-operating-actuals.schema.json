{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mooncast.control-tower-operating-actuals.v1",
  "title": "Evidence-bound operating actuals",
  "type": "object",
  "required": [
    "contract",
    "command_id",
    "project_id",
    "version",
    "project_revision",
    "provider_cost_reconciled",
    "evidence_refs",
    "actor",
    "actor_role",
    "observed_at",
    "digest"
  ],
  "properties": {
    "contract": {"const": "mooncast.control-tower-operating-actuals.v1"},
    "command_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "project_revision": {"type": "integer", "minimum": 0},
    "provider_cost_confirmed_cny": {"type": ["number", "null"], "minimum": 0},
    "labor_cost_cny": {"type": ["number", "null"], "minimum": 0},
    "other_cost_cny": {"type": ["number", "null"], "minimum": 0},
    "recognized_revenue_cny": {"type": ["number", "null"], "minimum": 0},
    "founder_hours": {"type": ["number", "null"], "minimum": 0},
    "completed_labor_hours": {"type": ["number", "null"], "minimum": 0},
    "forecast_completion_date": {"type": ["string", "null"], "format": "date"},
    "provider_cost_reconciled": {"type": "boolean"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "actor": {"type": "string", "minLength": 1},
    "actor_role": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "minLength": 1},
    "digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
