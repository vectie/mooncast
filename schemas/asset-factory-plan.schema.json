{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncast.local/schemas/asset-factory-plan.schema.json",
  "title": "Mooncast reusable asset factory plan",
  "type": "object",
  "required": ["contract", "plan", "project_id", "project_revision", "specs", "total_cost_ceiling_cny", "created_at", "publication_authority", "provider_execution_authority"],
  "properties": {
    "contract": {"const": "mooncast.asset-factory-plan.v1"},
    "plan": {"type": "object", "required": ["id", "version", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false},
    "project_id": {"type": "string", "minLength": 1},
    "project_revision": {"type": "integer", "minimum": 0},
    "specs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["asset_id", "asset_version", "kind", "capability", "intent", "prompt_digest", "rights_refs", "continuity_key", "provider_adapter_id", "provider", "model", "permitted_data_class", "variant_limit", "retry_limit", "cost_ceiling_cny", "dependent_shot_ids"], "properties": {"asset_id": {"type": "string", "minLength": 1}, "asset_version": {"type": "integer", "minimum": 1}, "kind": {"enum": ["character", "location", "prop", "voice", "music", "motion", "image", "text"]}, "capability": {"enum": ["text", "image", "video", "voice", "music"]}, "intent": {"type": "object"}, "prompt_digest": {"type": "string"}, "rights_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "continuity_key": {"type": "string"}, "provider_adapter_id": {"type": "string"}, "provider": {"type": "string"}, "model": {"type": "string"}, "permitted_data_class": {"type": "string"}, "variant_limit": {"type": "integer", "minimum": 1, "maximum": 4}, "retry_limit": {"type": "integer", "minimum": 1, "maximum": 5}, "cost_ceiling_cny": {"type": "number", "minimum": 0}, "dependent_shot_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "total_cost_ceiling_cny": {"type": "number", "minimum": 0},
    "created_at": {"type": "string", "minLength": 1},
    "publication_authority": {"const": false},
    "provider_execution_authority": {"const": false}
  },
  "additionalProperties": true
}
