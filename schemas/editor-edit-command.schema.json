{
  "$id": "https://mooncast.local/contracts/editor-edit-command.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {"$ref": "#/$defs/id"},
        "provenance": {"minLength": 1, "type": "string"}
      },
      "required": ["actor_id", "provenance"],
      "type": "object"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "keyframePoint": {
      "additionalProperties": false,
      "properties": {
        "tick": {"minimum": 0, "type": "integer"},
        "value": {"type": "number"},
        "interpolation": {
          "enum": ["hold", "linear", "ease-in", "ease-out", "ease-in-out"]
        }
      },
      "required": ["tick", "value", "interpolation"],
      "type": "object"
    },
    "keyframes": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "opacity": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/keyframePoint"}, {"properties": {"value": {"minimum": 0, "maximum": 1}}}]}},
        "scale": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/keyframePoint"}, {"properties": {"value": {"minimum": 0.1, "maximum": 4}}}]}},
        "position_x": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/keyframePoint"}, {"properties": {"value": {"minimum": -1, "maximum": 1}}}]}},
        "position_y": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/keyframePoint"}, {"properties": {"value": {"minimum": -1, "maximum": 1}}}]}},
        "brightness": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/keyframePoint"}, {"properties": {"value": {"minimum": -1, "maximum": 1}}}]}},
        "contrast": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/keyframePoint"}, {"properties": {"value": {"minimum": 0, "maximum": 3}}}]}},
        "saturation": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/keyframePoint"}, {"properties": {"value": {"minimum": 0, "maximum": 3}}}]}},
        "gamma": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/keyframePoint"}, {"properties": {"value": {"minimum": 0.1, "maximum": 3}}}]}},
        "volume_db": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/keyframePoint"}, {"properties": {"value": {"minimum": -60, "maximum": 12}}}]}},
        "pan": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/keyframePoint"}, {"properties": {"value": {"minimum": -1, "maximum": 1}}}]}}
      },
      "type": "object"
    },
    "transitionInput": {
      "type": "object", "additionalProperties": false,
      "required": ["transition_id", "track_id", "from_clip_id", "to_clip_id", "kind", "duration_ticks", "outgoing_handle_ticks", "incoming_handle_ticks", "color", "direction"],
      "properties": {
        "transition_id": {"$ref": "#/$defs/id"}, "track_id": {"$ref": "#/$defs/id"},
        "from_clip_id": {"$ref": "#/$defs/id"}, "to_clip_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["cut", "cross-dissolve", "fade-through-color", "wipe-left", "wipe-right", "equal-power-crossfade"]},
        "duration_ticks": {"type": "integer", "minimum": 0},
        "outgoing_handle_ticks": {"type": "integer", "minimum": 0},
        "incoming_handle_ticks": {"type": "integer", "minimum": 0},
        "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"},
        "direction": {"enum": ["none", "left", "right"]}
      }
    }
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "actor": {"$ref": "#/$defs/actor"}, "command_id": {"$ref": "#/$defs/id"},
        "contract": {"const": "mooncast.editor-edit-command.v1"}, "expected_revision": {"minimum": 0, "type": "integer"},
        "payload": {"type": "object", "additionalProperties": false, "required": ["transition"], "properties": {"transition": {"$ref": "#/$defs/transitionInput"}}},
        "type": {"const": "configure_transition"}
      },
      "required": ["contract", "command_id", "expected_revision", "actor", "type", "payload"], "type": "object"
    },
