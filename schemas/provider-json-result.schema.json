{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncast.local/contracts/provider-json-result.v1.schema.json",
  "title": "Vendor-neutral JSON POST provider result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "artifacts", "usage", "cost", "provider_receipt"],
  "properties": {
    "contract": {"const": "mooncast.provider-json-result.v1"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["modality"],
        "properties": {
          "modality": {"enum": ["text", "image", "video", "voice", "music"]},
          "text": {"type": "string"},
          "content_base64": {"type": "string"},
          "mime_type": {"type": "string"},
          "duration_seconds": {"type": ["number", "null"], "minimum": 0},
          "source_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "usage": {"type": "object"},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount"],
      "properties": {
        "currency": {"const": "CNY"},
        "amount": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}]}
      }
    },
    "provider_receipt": {"type": "object"}
  }
}
