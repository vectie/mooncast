{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncast.local/schemas/shot-asset-binding.schema.json",
  "title": "Mooncast exact shot reusable asset binding",
  "type": "object",
  "required": ["contract", "binding_id", "project_id", "project_revision", "shot_id", "assets", "approval_digests", "bound_at", "immutable", "publication_authority"],
  "properties": {
    "contract": {"const": "mooncast.shot-asset-binding.v1"},
    "binding_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "project_revision": {"type": "integer", "minimum": 0},
    "shot_id": {"type": "string", "minLength": 1},
    "assets": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "approval_digests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "bound_at": {"type": "string", "minLength": 1},
    "immutable": {"const": true},
    "publication_authority": {"const": false}
  },
  "additionalProperties": false
}
