{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mooncast.control-tower-exception-assignment.v1",
  "title": "Named control-tower exception assignment",
  "type": "object",
  "required": [
    "contract",
    "command_id",
    "exception_id",
    "exception_digest",
    "version",
    "owner",
    "owner_role",
    "action_due_date",
    "note",
    "assigned_by",
    "assigned_by_role",
    "assigned_at",
    "human_confirmed",
    "external_effect_authorized",
    "digest"
  ],
  "properties": {
    "contract": {"const": "mooncast.control-tower-exception-assignment.v1"},
    "command_id": {"type": "string", "minLength": 1},
    "exception_id": {"type": "string", "minLength": 1},
    "exception_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "version": {"type": "integer", "minimum": 1},
    "owner": {"type": "string", "minLength": 1},
    "owner_role": {"type": "string", "minLength": 1},
    "action_due_date": {"type": "string", "format": "date"},
    "note": {"type": "string"},
    "assigned_by": {"type": "string", "minLength": 1},
    "assigned_by_role": {"type": "string", "minLength": 1},
    "assigned_at": {"type": "string", "minLength": 1},
    "human_confirmed": {"const": true},
    "external_effect_authorized": {"const": false},
    "digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
