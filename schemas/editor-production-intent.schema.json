{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncast.local/contracts/editor-production-intent.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "project_id",
    "expected_production_revision",
    "expected_editor_revision",
    "ticks_per_second",
    "budget_ceiling",
    "current_client_revision_rounds",
    "max_client_revision_rounds",
    "take_selections",
    "placements",
    "track_role_map",
    "annotations",
    "review_comments",
    "delivery_intents"
  ],
  "properties": {
    "contract": {
      "const": "mooncast.editor-production-intent.v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "expected_production_revision": {
      "type": "integer",
      "minimum": 0
    },
    "expected_editor_revision": {
      "type": "integer",
      "minimum": 0
    },
    "ticks_per_second": {
      "type": "integer",
      "minimum": 1
    },
    "budget_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          ]
        },
        "currency": {
          "const": "CNY"
        }
      }
    },
    "current_client_revision_rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "max_client_revision_rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "take_selections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot_id",
          "take_id"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "take_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "placement_id",
          "take_id",
          "role",
          "start_tick",
          "duration_ticks"
        ],
        "properties": {
          "placement_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "take_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "role": {
            "enum": [
              "video",
              "dialogue",
              "voice",
              "music",
              "SFX",
              "subtitle",
              "title",
              "effect",
              "AI-label"
            ]
          },
          "start_tick": {
            "type": "integer",
            "minimum": 0
          },
          "duration_ticks": {
            "type": "integer",
            "minimum": 1
          },
          "source_in_tick": {
            "type": "integer",
            "minimum": 0
          },
          "source_start_tick": {
            "type": "integer",
            "minimum": 0
          },
          "intent_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "track_role_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video",
        "dialogue",
        "voice",
        "music",
        "SFX",
        "subtitle",
        "title",
        "effect",
        "AI-label"
      ],
      "properties": {
        "video": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "dialogue": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "voice": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "music": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "SFX": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "subtitle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "title": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "effect": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "AI-label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "annotation_id",
          "kind",
          "range"
        ],
        "properties": {
          "annotation_id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "continuity",
              "QC"
            ]
          },
          "range": {
            "$ref": "#/$defs/range"
          }
        }
      }
    },
    "review_comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "comment_id",
          "range",
          "text",
          "revision_round"
        ],
        "properties": {
          "comment_id": {
            "$ref": "#/$defs/id"
          },
          "range": {
            "$ref": "#/$defs/range"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "revision_round": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        }
      }
    },
    "delivery_intents": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "contains": {
        "properties": {
          "orientation": {
            "const": "horizontal"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delivery_id",
          "orientation",
          "width",
          "height"
        ],
        "properties": {
          "delivery_id": {
            "$ref": "#/$defs/id"
          },
          "orientation": {
            "enum": [
              "horizontal",
              "vertical"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_tick",
        "end_tick"
      ],
      "properties": {
        "start_tick": {
          "type": "integer",
          "minimum": 0
        },
        "end_tick": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
