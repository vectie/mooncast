{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncast.local/contracts/provider-adapter-config.v1.schema.json",
  "title": "Mooncast host-configured provider adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_id", "capability", "provider", "endpoint", "model", "api_style", "secret_refs", "timeout_seconds", "default_parameters", "commercial_use"],
  "properties": {
    "adapter_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "capability": {"enum": ["text", "image", "video", "voice", "music"]},
    "provider": {"type": "string", "minLength": 1},
    "endpoint": {"type": "string", "pattern": "^https://"},
    "model": {"type": "string", "minLength": 1},
    "api_style": {"enum": ["openai-compatible", "json"]},
    "secret_refs": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^host-secret:[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "default_parameters": {"type": "object"},
    "commercial_use": {"type": "string", "minLength": 1},
    "network_authority": {"const": false}
  }
}
