{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncast.local/contracts/editor-generated-take.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "take_id",
    "attempt_id",
    "project_id",
    "episode_id",
    "scene_id",
    "shot_id",
    "asset_id",
    "role",
    "variant",
    "provider_ref",
    "model_ref",
    "model_version",
    "seed",
    "prompt_digest",
    "content_sha256",
    "mime_type",
    "duration_ticks",
    "source_asset_ids",
    "cost",
    "rights",
    "qc",
    "created_at"
  ],
  "properties": {
    "contract": {
      "const": "mooncast.editor-generated-take.v1"
    },
    "take_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "shot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "role": {
      "enum": [
        "video",
        "dialogue",
        "voice",
        "music",
        "SFX",
        "subtitle",
        "title",
        "effect",
        "AI-label"
      ]
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "provider_ref": {
      "type": "string",
      "minLength": 1
    },
    "model_ref": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "prompt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mime_type": {
      "type": "string",
      "minLength": 1
    },
    "duration_ticks": {
      "type": "integer",
      "minimum": 1
    },
    "source_asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "uniqueItems": true
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          ]
        },
        "currency": {
          "const": "CNY"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "refs"
      ],
      "properties": {
        "status": {
          "const": "cleared"
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "findings": {
          "type": "array",
          "items": {}
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
