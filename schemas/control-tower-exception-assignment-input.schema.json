{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mooncast.control-tower-exception-assignment-input.v1",
  "title": "Named control-tower exception assignment command",
  "type": "object",
  "required": [
    "command_id",
    "expected_exception_digest",
    "owner",
    "owner_role",
    "action_due_date",
    "note",
    "assigned_by",
    "assigned_by_role",
    "assigned_at",
    "human_confirmed"
  ],
  "properties": {
    "command_id": {"type": "string", "minLength": 1},
    "expected_exception_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expected_assignment_version": {"type": ["integer", "null"], "minimum": 1},
    "expected_assignment_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "owner": {"type": "string", "minLength": 1},
    "owner_role": {"type": "string", "minLength": 1},
    "action_due_date": {"type": "string", "format": "date"},
    "note": {"type": "string"},
    "assigned_by": {"type": "string", "minLength": 1},
    "assigned_by_role": {"type": "string", "minLength": 1},
    "assigned_at": {"type": "string", "minLength": 1},
    "human_confirmed": {"const": true}
  },
  "additionalProperties": false
}
