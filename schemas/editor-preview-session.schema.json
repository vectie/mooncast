{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncast.dev/schemas/editor-preview-session.schema.json",
  "title": "Mooncast Editor Preview Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "session_id",
    "state",
    "plan_digest",
    "created_at",
    "output_refs",
    "error",
    "publication_authority"
  ],
  "properties": {
    "contract": {
      "const": "mooncast.editor-preview-session.v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "output_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ephemeral:"
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {}
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "publication_authority": {
      "const": false
    }
  }
}
