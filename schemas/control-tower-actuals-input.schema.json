{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mooncast.control-tower-actuals-input.v1",
  "title": "Evidence-bound operating actuals command",
  "type": "object",
  "required": [
    "command_id",
    "expected_project_revision",
    "provider_cost_reconciled",
    "evidence_refs",
    "actor",
    "actor_role",
    "observed_at",
    "human_confirmed"
  ],
  "properties": {
    "command_id": {"type": "string", "minLength": 1},
    "expected_project_revision": {"type": "integer", "minimum": 0},
    "expected_actuals_version": {"type": ["integer", "null"], "minimum": 1},
    "expected_actuals_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provider_cost_confirmed_cny": {"type": ["number", "null"], "minimum": 0},
    "labor_cost_cny": {"type": ["number", "null"], "minimum": 0},
    "other_cost_cny": {"type": ["number", "null"], "minimum": 0},
    "recognized_revenue_cny": {"type": ["number", "null"], "minimum": 0},
    "founder_hours": {"type": ["number", "null"], "minimum": 0},
    "completed_labor_hours": {"type": ["number", "null"], "minimum": 0},
    "forecast_completion_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "provider_cost_reconciled": {"type": "boolean"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "actor": {"type": "string", "minLength": 1},
    "actor_role": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "minLength": 1},
    "human_confirmed": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"provider_cost_reconciled": {"const": true}}},
      "then": {
        "required": ["provider_cost_confirmed_cny"],
        "properties": {
          "provider_cost_confirmed_cny": {"type": "number", "minimum": 0}
        }
      }
    }
  ],
  "additionalProperties": false
}
