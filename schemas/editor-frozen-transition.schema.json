{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncast.local/schemas/editor-frozen-transition.schema.json",
  "title": "Frozen render transition",
  "type": "object",
  "additionalProperties": false,
  "required": ["transition_id", "track_id", "from_clip_id", "to_clip_id", "kind", "duration_ticks", "outgoing_handle_ticks", "incoming_handle_ticks", "color", "direction", "transition_digest", "relationship", "cut_tick", "range"],
  "properties": {
    "transition_id": {"$ref": "#/$defs/id"}, "track_id": {"$ref": "#/$defs/id"},
    "from_clip_id": {"$ref": "#/$defs/id"}, "to_clip_id": {"$ref": "#/$defs/id"},
    "kind": {"enum": ["cut", "cross-dissolve", "fade-through-color", "wipe-left", "wipe-right", "equal-power-crossfade"]},
    "duration_ticks": {"type": "integer", "minimum": 0},
    "outgoing_handle_ticks": {"type": "integer", "minimum": 0},
    "incoming_handle_ticks": {"type": "integer", "minimum": 0},
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"},
    "direction": {"enum": ["none", "left", "right"]},
    "transition_digest": {"$ref": "#/$defs/digest"},
    "relationship": {"enum": ["edit-point", "layer-overlap"]},
    "cut_tick": {"type": "integer", "minimum": 0},
    "range": {"type": "object", "additionalProperties": false, "required": ["start_tick", "duration_ticks"], "properties": {"start_tick": {"type": "integer", "minimum": 0}, "duration_ticks": {"type": "integer", "minimum": 0}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
