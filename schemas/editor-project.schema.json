{
  "$id": "https://mooncast.local/contracts/editor-project.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "contract": {
            "const": "mooncast.editor-aigc-artifact.v1"
          },
          "model": {
            "minLength": 1,
            "type": "string"
          },
          "output_media_ref_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "prompt_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "provider": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "review_state": {
            "enum": [
              "pending",
              "accepted",
              "rejected"
            ]
          },
          "rights_state": {
            "enum": [
              "unknown",
              "cleared",
              "restricted"
            ]
          },
          "source_refs": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "contract",
          "artifact_id",
          "source_refs",
          "output_media_ref_ids",
          "provider",
          "model",
          "prompt_digest",
          "rights_state",
          "review_state"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "contract": {
      "const": "mooncast.editor-project.v1"
    },
    "identity_graph": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "episode_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "project_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "scene_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "shot_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "episode_id",
          "scene_id",
          "shot_id",
          "asset_id"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "intent_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "intent_ref": {
            "pattern": "^moonwiki:intent:[A-Za-z0-9._:-]+$",
            "type": "string"
          }
        },
        "required": [
          "intent_ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "media_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "contract": {
            "const": "mooncast.editor-media-ref.v1"
          },
          "locator": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "pack-relative"
              },
              "uri": {
                "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "uri"
            ],
            "type": "object"
          },
          "media_ref_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": false,
            "properties": {
              "duration_ticks": {
                "minimum": 0,
                "type": "integer"
              },
              "mime_type": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "size_bytes": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "sha256",
              "mime_type",
              "size_bytes"
            ],
            "type": "object"
          }
        },
        "required": [
          "contract",
          "media_ref_id",
          "locator",
          "metadata"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "project_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "type": "integer"
    },
    "timeline": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "mooncast.editor-timeline.v1"
        },
        "revision": {
          "minimum": 0,
          "type": "integer"
        },
        "timebase": {
          "additionalProperties": false,
          "properties": {
            "ticks_per_second": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "ticks_per_second"
          ],
          "type": "object"
        },
        "timeline_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preset", "orientation", "width", "height", "fps", "background"],
          "properties": {
            "preset": {"enum": ["horizontal-1080p", "vertical-1080p"]},
            "orientation": {"enum": ["horizontal", "vertical"]},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "fps": {"type": "object", "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer", "minimum": 1}, "denominator": {"type": "integer", "minimum": 1}}},
            "background": {"type": "string", "minLength": 1}
          }
        },
        "tracks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "clips": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "artifact_id": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    },
                    "clip_id": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    },
                    "duration_ticks": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "identity": {
                      "additionalProperties": false,
                      "properties": {
                        "asset_id": {
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                          "type": "string"
                        },
                        "episode_id": {
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                          "type": "string"
                        },
                        "project_id": {
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                          "type": "string"
                        },
                        "scene_id": {
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                          "type": "string"
                        },
                        "shot_id": {
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "project_id",
                        "episode_id",
                        "scene_id",
                        "shot_id",
                        "asset_id"
                      ],
                      "type": "object"
                    },
                    "intent": {
                      "additionalProperties": false,
                      "properties": {
                        "intent_ref": {
                          "pattern": "^moonwiki:intent:[A-Za-z0-9._:-]+$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "intent_ref"
                      ],
                      "type": "object"
                    },
                    "media_ref_id": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string"
                    },
                    "source_in_tick": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "source_out_tick": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "start_tick": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "settings": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "clip_id",
                    "media_ref_id",
                    "identity",
                    "intent",
                    "start_tick",
                    "duration_ticks",
                    "source_in_tick",
                    "source_out_tick"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "kind": {
                "enum": [
                  "video",
                  "audio",
                  "overlay"
                ]
              },
              "order": {
                "minimum": 0,
                "type": "integer"
              },
              "mix": {
                "type": "object",
                "required": ["volume_db", "pan", "muted"],
                "properties": {
                  "volume_db": {"type": "number", "minimum": -60, "maximum": 12},
                  "pan": {"type": "number", "minimum": -1, "maximum": 1},
                  "muted": {"type": "boolean"}
                }
              },
              "track_id": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "type": "string"
              }
            },
            "required": [
              "track_id",
              "kind",
              "order",
              "clips"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "contract",
        "timeline_id",
        "revision",
        "timebase",
        "output",
        "tracks"
      ],
      "type": "object"
    }
  },
  "required": [
    "contract",
    "project_id",
    "revision",
    "identity_graph",
    "intent_refs",
    "media_refs",
    "artifacts",
    "timeline"
  ],
  "title": "Editor Project Snapshot v1",
  "type": "object"
}
