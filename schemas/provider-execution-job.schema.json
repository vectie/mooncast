{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncast.local/contracts/provider-execution-job.v1.schema.json",
  "title": "Durable provider execution job",
  "type": "object",
  "required": ["contract", "job_id", "state", "revision", "plan_digest", "config_digest", "binding_digest", "authority", "adapter_id", "capability", "attempt_count", "max_attempts", "attempt_history", "artifacts", "publication_authority"],
  "properties": {
    "contract": {"const": "mooncast.provider-execution-job.v1"},
    "job_id": {"type": "string", "pattern": "^job-[0-9a-f]{24}$"},
    "state": {"enum": ["authorized", "running", "cancel_requested", "retryable_failure", "timed_out", "ingest_failed", "completed", "cancelled", "failed", "cost_ceiling_exceeded"]},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "plan": {"type": "object"},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority": {"type": "object"},
    "adapter_id": {"type": "string"},
    "capability": {"enum": ["text", "image", "video", "voice", "music"]},
    "attempt_count": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
    "active_attempt_id": {"type": ["string", "null"]},
    "attempt_started_at": {"type": "string"},
    "attempt_history": {"type": "array", "items": {"type": "object"}},
    "response_digest": {"type": ["string", "null"]},
    "response_ref": {"type": "string"},
    "usage_cost_receipt": {"type": ["object", "null"]},
    "artifacts": {"type": "array", "items": {"$ref": "provider-result-artifact.v1.schema.json"}},
    "project_ingest": {"type": ["object", "null"]},
    "last_error": {"type": ["object", "null"]},
    "publication_authority": {"const": false}
  },
  "additionalProperties": false
}
