        "cut-editor", "/apps/mooncast/editor", "editor-operator",
      ),
      @pack.app_entrypoint(
        "client-review", "/apps/mooncast/client", "client-reviewer",
      ),
      @pack.app_entrypoint(
        "campaign-studio", "/apps/mooncast/studio", "deprecated-campaign-operator-compatibility-alias",
      ),
    ],
    migrations: [contract("mooncast-install", "migrations/install.md")],
    evaluations: [
      contract("delivery-acceptance", "evaluations/delivery-acceptance.md"),
      contract("systematic-production", "evaluations/systematic-production.md"),
    ],
    uninstall_contract: Some(contract("mooncast-uninstall", "UNINSTALL.md")),
  }
}
