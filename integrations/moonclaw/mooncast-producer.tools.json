{
  "contract": "mooncast.producer-http-tools.v1",
  "adapter": "moon run cmd/mooncast_producer_tool --",
  "moonclaw_execution_tool": "shell",
  "custom_tool_registration": false,
  "base_url_env": "MOONCAST_STUDIO_URL",
  "default_base_url": "http://127.0.0.1:8765",
  "tools": [
    {"id":"health","method":"GET","path":"/health","authority":"Observe","body":"none"},
    {"id":"project.list","method":"GET","path":"/api/v2/projects","authority":"Observe","body":"none"},
    {"id":"project.get","method":"GET","path":"/api/v2/projects/{project_id}","authority":"Observe","body":"none"},
    {"id":"project.events","method":"GET","path":"/api/v2/projects/{project_id}/events","authority":"Observe","body":"none"},
    {"id":"project.governance","method":"GET","path":"/api/v2/projects/{project_id}/governance","authority":"Observe","body":"none"},
    {"id":"workspace.catalog","method":"GET","path":"/api/workspace/catalog","authority":"Observe","body":"none"},
    {"id":"workspace.capsules","method":"GET","path":"/api/workspace/projects/{project_id}/capsules","authority":"Observe","body":"none"},
    {"id":"workspace.artifacts","method":"GET","path":"/api/workspace/projects/{project_id}/artifacts","authority":"Observe","body":"none"},
    {"id":"workspace.features","method":"GET","path":"/api/workspace/projects/{project_id}/features","authority":"Observe","body":"none"},
    {"id":"workspace.search","method":"POST","path":"/api/workspace/search","authority":"Observe","body":"json"},
    {"id":"workspace.proposals","method":"GET","path":"/api/workspace/projects/{project_id}/proposals","authority":"Observe","body":"none"},
    {"id":"workspace.graph.get","method":"GET","path":"/api/workspace/projects/{project_id}/graphs/{graph_id}","authority":"Observe","body":"none"},
    {"id":"workspace.graph.compare","method":"POST","path":"/api/workspace/graphs/compare","authority":"Observe","body":"json"},
    {"id":"workspace.graph.fork","method":"POST","path":"/api/workspace/projects/{project_id}/graphs/{graph_id}/fork","authority":"WorkspaceMutation","body":"json"},
    {"id":"workspace.proposal.create","method":"POST","path":"/api/workspace/proposals","authority":"WorkspaceMutation","body":"json"},
    {"id":"workspace.proposal.apply","method":"POST","path":"/api/workspace/proposals/apply","authority":"WorkspaceMutation","body":"json","human_review_required":true},
    {"id":"workspace.plan.create","method":"POST","path":"/api/workspace/plans","authority":"WorkspaceMutation","body":"json"},
    {"id":"workspace.recipe.run","method":"POST","path":"/api/workspace/recipes/{capsule_id}/runs","authority":"WorkspaceMutation","body":"json"},
    {"id":"workspace.run.create","method":"POST","path":"/api/workspace/runs","authority":"WorkspaceMutation","body":"json"},
    {"id":"workspace.run.get","method":"GET","path":"/api/workspace/runs/{run_id}","authority":"Observe","body":"none"},
    {"id":"workspace.run.events","method":"GET","path":"/api/workspace/runs/{run_id}/events","authority":"Observe","body":"none"},
    {"id":"workspace.run.command","method":"POST","path":"/api/workspace/runs/{run_id}/commands","authority":"WorkspaceMutation","body":"json"},
    {"id":"workspace.run.dispatch","method":"POST","path":"/api/workspace/runs/{run_id}/nodes/{node_id}/dispatch","authority":"ExternalEffect","body":"json","human_review_required":true},
    {"id":"workspace.run.promote-template","method":"POST","path":"/api/workspace/runs/{run_id}/promote-template","authority":"WorkspaceMutation","body":"json","human_review_required":true},
    {"id":"workspace.dispatch.receipt","method":"POST","path":"/api/workspace/dispatches/{dispatch_id}/receipt","authority":"WorkspaceMutation","body":"json"},
    {"id":"workspace.artifact.save","method":"POST","path":"/api/workspace/artifacts","authority":"WorkspaceMutation","body":"json"},
    {"id":"workspace.artifact.compare","method":"POST","path":"/api/workspace/artifacts/compare","authority":"Observe","body":"json"},
    {"id":"workspace.artifact.promote","method":"POST","path":"/api/workspace/artifacts/promote","authority":"WorkspaceMutation","body":"json","human_review_required":true},
    {"id":"workspace.artifact.branch","method":"POST","path":"/api/workspace/artifacts/{artifact_id}/branch","authority":"WorkspaceMutation","body":"json"},
    {"id":"workspace.comment.create","method":"POST","path":"/api/workspace/comments","authority":"WorkspaceMutation","body":"json"},
    {"id":"workspace.presence.renew","method":"POST","path":"/api/workspace/presence","authority":"WorkspaceMutation","body":"json"},
    {"id":"workspace.share.create","method":"POST","path":"/api/workspace/shares","authority":"WorkspaceMutation","body":"json","human_review_required":true},
    {"id":"workspace.capsule.publish","method":"POST","path":"/api/workspace/capsules/publish","authority":"WorkspaceMutation","body":"json","human_review_required":true},
    {"id":"workspace.capsule.publish-builtin","method":"POST","path":"/api/workspace/capsules/{capsule_id}/publish","authority":"WorkspaceMutation","body":"json","human_review_required":true},
    {"id":"project.advance","method":"POST","path":"/api/v2/projects/{project_id}/advance","authority":"WorkspaceMutation","body":"json","human_review_required":true},
    {"id":"routed-execution.list","method":"GET","path":"/api/v2/projects/{project_id}/routed-executions","authority":"Observe","body":"none"},
    {"id":"routed-execution.get","method":"GET","path":"/api/v2/projects/{project_id}/routed-executions/{execution_id}","authority":"Observe","body":"none"},
    {"id":"routed-execution.create","method":"POST","path":"/api/v2/projects/{project_id}/routed-executions","authority":"WorkspaceMutation","body":"json","human_review_required":true},
    {"id":"production-coordinator.run-pending","method":"POST","path":"/api/v2/projects/{project_id}/production-coordinator/routed-executions/{execution_id}/run-pending","authority":"ExternalEffect","body":"json","human_review_required":true},
    {"id":"production-coordinator.confirm-qc","method":"POST","path":"/api/v2/projects/{project_id}/production-coordinator/qc-batches","authority":"WorkspaceMutation","body":"json","human_review_required":true},
    {"id":"editor.production-import","method":"POST","path":"/api/editor/projects/{project_id}/production-import","authority":"WorkspaceMutation","body":"json-or-empty"},
    {"id":"editor.get","method":"GET","path":"/api/editor/projects/{project_id}","authority":"Observe","body":"none"},
    {"id":"editor.export.create","method":"POST","path":"/api/editor/projects/{project_id}/exports","authority":"SandboxExecution","body":"json"},
    {"id":"editor.export.get","method":"GET","path":"/api/editor/projects/{project_id}/exports/{job_id}","authority":"Observe","body":"none"},
    {"id":"editor.export.promote-master","method":"POST","path":"/api/editor/projects/{project_id}/exports/{job_id}/promote-master","authority":"WorkspaceMutation","body":"json","human_review_required":true},
    {"id":"delivery-build.list","method":"GET","path":"/api/v2/projects/{project_id}/delivery-builds","authority":"Observe","body":"none"},
    {"id":"delivery-build.get","method":"GET","path":"/api/v2/projects/{project_id}/delivery-builds/{build_id}","authority":"Observe","body":"none"},
    {"id":"delivery-build.create","method":"POST","path":"/api/v2/projects/{project_id}/delivery-builds","authority":"WorkspaceMutation","body":"json"},
    {"id":"delivery-build.build","method":"POST","path":"/api/v2/projects/{project_id}/delivery-builds/{build_id}/build","authority":"SandboxExecution","body":"json"},
    {"id":"delivery-build.retry","method":"POST","path":"/api/v2/projects/{project_id}/delivery-builds/{build_id}/retry","authority":"SandboxExecution","body":"json"},
    {"id":"delivery-build.accept","method":"POST","path":"/api/v2/projects/{project_id}/delivery-builds/{build_id}/acceptance","authority":"WorkspaceMutation","body":"json","human_review_required":true}
  ],
  "limits": {
    "request_body_bytes": 1048576,
    "response_bytes": 8388608,
    "request_timeout_ms": 600000,
    "network_scope": "loopback-http-only"
  },
  "excluded_effects": ["publication", "payment", "client-impersonation"]
}
